# Copie este archivo como .env y ajuste los valores. Nunca suba .env a GitHub.
# Todos los valores son opcionales: los indicados son los predeterminados.

# Base de datos (SQLite local). Futuro: postgresql+psycopg://usuario:clave@localhost/neuroambiental
# NEURO_DATABASE_URL=sqlite:///D:/Proyectos/neuroambiental-ia/data/neuroambiental.db

# Carpeta donde se guardan los archivos cargados
# NEURO_UPLOADS_DIR=D:/Proyectos/neuroambiental-ia/data/uploads

# Límites de carga
NEURO_MAX_UPLOAD_MB=10
NEURO_MAX_CSV_ROWS=50000

# Duración de la sesión en horas
NEURO_SESSION_HOURS=12

# Orígenes permitidos por CORS (solo necesario en modo desarrollo con Vite)
NEURO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
